#!/usr/bin/env python3
"""harbor — 鸿蒙版 brew services（基于 Harbor HAP 的回环 IPC）。

子命令（对齐 brew services）：
  list              列出所有服务状态（默认）
  start <name>      启动服务
  stop <name>       停止服务
  restart <name>    重启服务
  status <name>     单个服务状态
  info <name>       服务详情（Command/Log/Env）
  discover          扫描已装 brew formula 的 .service，提示可加入的服务
  cleanup           清理已卸载 brew formula 的失效服务（默认软禁用；--prune 彻底移除）
  set-autohide <t|f> 设置启动时是否自动隐藏到托盘（开机自启场景设 true）
  set-timer <name> cron <OnCalendar> | interval <秒> | off   设置/取消定时任务
  reload            让 HAP 重读配置
  ping              测试 IPC 连通性

配置：~/.config/harbor/apps.json
IPC：127.0.0.1:19876（Harbor HAP 内 TCPSocketServer）
"""
import json
import os
import socket
import sys
import glob

HOST = "127.0.0.1"
PORT = 19876
CONFIG = os.path.expanduser("~/.config/harbor/apps.json")
IPC_CONF = os.path.expanduser("~/.config/harbor/ipc.conf")
CELLAR = os.path.expanduser("~/.harmonybrew/Cellar")
BREW_OPT = os.path.expanduser("~/.harmonybrew/opt")


def is_brew_unit(unit: str) -> bool:
    """是否 brew 管理的 unit（稳定 opt/ 路径）。判据对齐 brew services cleanup：
    只有后端 brew 生成的 unit 才归 brew 清理，手工 unit 一律跳过。"""
    try:
        return os.path.commonpath([os.path.abspath(unit), os.path.abspath(BREW_OPT)]) == \
            os.path.abspath(BREW_OPT)
    except ValueError:
        return False


def find_stale_brew_apps(cfg: dict) -> list:
    """找出 brew 已卸载的服务：brew unit 文件已不在磁盘。
    对齐 brew services cleanup 的权威信号（dest.file? 不存在），
    仅检测、不修改 cfg。"""
    stale = []
    for app in cfg.get("apps", []):
        if app.get("type") != "unit":
            continue
        unit = app.get("unit", "")
        if not unit or not is_brew_unit(unit):
            continue
        if not os.path.exists(unit):
            stale.append(app)
    return stale


def disable_stale_brew_apps(cfg: dict) -> list:
    """默认清理：把失效的 brew 服务标记 enabled:false（可逆，重装后可恢复）。
    返回本次新禁用（原本未禁用）的服务名列表。"""
    changed = []
    for app in find_stale_brew_apps(cfg):
        if app.get("enabled") is not False:
            app["enabled"] = False
            changed.append(app["name"])
    return changed


def prune_stale_brew_apps(cfg: dict) -> list:
    """--prune 清理：从 cfg['apps'] 彻底移除失效的 brew 服务。
    直接返回保留的 apps 列表，不修改 cfg['apps'] 之外的字段。"""
    stale_names = {app["name"] for app in find_stale_brew_apps(cfg)}
    return [app for app in cfg.get("apps", []) if app["name"] not in stale_names]


def report_stale_brew_apps(cfg: dict, verb: str = "发现") -> int:
    """CLI 每次运行入口调用：只提示、不改配置（对齐 systemd 的 not-found 状态展示）。
    返回失效项数量，0 表示干净。"""
    stale = find_stale_brew_apps(cfg)
    if not stale:
        return 0
    print(f"[{verb}] {len(stale)} 个 brew 服务已失效（unit 文件不存在，formula 可能已卸载）：",
          file=sys.stderr)
    for app in stale:
        print(f"    - {app['name']}: {app.get('unit', '')}", file=sys.stderr)
    print("    运行 'harbor cleanup' 清理；'harbor cleanup --prune' 彻底移除。", file=sys.stderr)
    return len(stale)


def read_token() -> str:
    """读 IPC token；不存在则生成（CLI 侧生成，避免 HAP 写宿主 .config 的权限问题）。"""
    import secrets
    try:
        with open(IPC_CONF, encoding="utf-8") as f:
            for line in f:
                if line.startswith("token="):
                    return line.split("=", 1)[1].strip()
    except FileNotFoundError:
        pass
    # 生成 64 hex token
    token = secrets.token_hex(32)
    os.makedirs(os.path.dirname(IPC_CONF), exist_ok=True)
    with open(IPC_CONF, "w", encoding="utf-8") as f:
        f.write(f"addr=127.0.0.1:{PORT}\ntoken={token}\n")
    try:
        os.chmod(IPC_CONF, 0o600)
    except OSError:
        pass
    print(f"已生成 IPC token -> {IPC_CONF}（HAP 下次命令自动读取）", file=sys.stderr)
    return token


def ipc(cmd: str, timeout: float = 10.0) -> str:
    """向 Harbor 发一条带鉴权的文本行命令，返回响应（去掉换行）。"""
    try:
        s = socket.create_connection((HOST, PORT), timeout=timeout)
    except OSError as e:
        print(f"ERR 无法连接 Harbor ({HOST}:{PORT}): {e}", file=sys.stderr)
        print("   HAP 是否已启动并缩到托盘？", file=sys.stderr)
        sys.exit(2)
    try:
        s.sendall(("AUTH " + read_token() + " " + cmd + "\n").encode())
        s.settimeout(timeout)
        data = b""
        while b"\n" not in data:
            chunk = s.recv(4096)
            if not chunk:
                break
            data += chunk
    finally:
        s.close()
    return data.decode(errors="replace").strip()


def read_config() -> dict:
    try:
        with open(CONFIG, encoding="utf-8") as f:
            return json.load(f)
    except FileNotFoundError:
        print(f"ERR 配置文件不存在: {CONFIG}", file=sys.stderr)
        sys.exit(2)
    except json.JSONDecodeError as e:
        print(f"ERR 配置解析失败: {e}", file=sys.stderr)
        sys.exit(2)


def parse_ok(resp: str):
    """解析 'OK <json>' / 'ERR <msg>'，失败则打印并退出。"""
    if resp.startswith("OK"):
        payload = resp[2:].strip()
        if not payload:
            return None
        try:
            return json.loads(payload)
        except json.JSONDecodeError:
            return payload
    print(resp, file=sys.stderr)
    sys.exit(1)


def cmd_list(args):
    resp = ipc("STATUS")
    services = parse_ok(resp)
    if not services:
        print("无服务")
        return
    name_w = max(len(s["name"]) for s in services)
    print(f"{'Name':<{name_w}}  {'Status':<12}  PID")
    print(f"{'-' * name_w}  {'-' * 12}  ---")
    for s in services:
        status = s.get("status", "?")
        pid = s.get("pid", 0)
        color = {"started": "\033[32m", "error": "\033[31m",
                 "not-found": "\033[31m"}.get(status, "")
        reset = "\033[0m" if color else ""
        print(f"{s['name']:<{name_w}}  {color}{status:<12}{reset}  {pid if pid else '-'}")
    if any(s.get("status") == "not-found" for s in services):
        print("提示：not-found = brew formula 已卸载，运行 'harbor cleanup' 清理（--prune 彻底移除）。")


def set_enabled(name: str, enabled: bool):
    """持久化服务的 enabled 状态（对齐 systemctl enable/disable）。"""
    cfg = read_config()
    found = False
    for a in cfg["apps"]:
        if a["name"] == name:
            a["enabled"] = enabled
            found = True
            break
    if found:
        write_config(cfg)
    return found


def cmd_simple(name: str, action: str):
    if not name:
        print(f"ERR {action} 需要服务名", file=sys.stderr)
        sys.exit(2)
    if action == "START":
        set_enabled(name, True)
    elif action == "STOP":
        set_enabled(name, False)
    resp = ipc(f"{action} {name}")
    result = parse_ok(resp)
    print(f"{name}: {result.get('result', 'ok') if isinstance(result, dict) else result}")


def cmd_status(args):
    services = parse_ok(ipc("STATUS"))
    target = args[0] if args else None
    shown = []
    for s in services or []:
        if target is None or s["name"] == target:
            print(f"{s['name']}: {s.get('status')} (pid {s.get('pid') or '-'})")
            shown.append(s)
    if any(s.get("status") == "not-found" for s in shown):
        print("提示：not-found = brew formula 已卸载，运行 'harbor cleanup' 清理（--prune 彻底移除）。")


def cmd_set_timer(args):
    """给服务设置定时任务（systemd timer 语义）。

    harbor set-timer <name> cron <OnCalendar>
      例: set-timer mihomo cron '*-*-* 03:00:00'     每天 03:00 重启
          set-timer mihomo cron 'Sun *-*-* 00:00:00' 每周日 00:00
          set-timer mihomo cron '*-*-* *:30:00'      每小时第 30 分
    harbor set-timer <name> interval <秒数>
      例: set-timer mihomo interval 3600             每 3600 秒重启
    harbor set-timer <name> off              取消定时
    """
    if len(args) < 2:
        print(cmd_set_timer.__doc__, file=sys.stderr)
        sys.exit(2)
    name, kind = args[0], args[1].lower()
    cfg = read_config()
    app = next((a for a in cfg["apps"] if a["name"] == name), None)
    if not app:
        print(f"ERR 无此服务: {name}", file=sys.stderr)
        sys.exit(1)
    if kind == "off":
        app.pop("timer", None)
        print(f"{name}: 定时已取消")
    elif kind == "cron" and len(args) >= 3:
        app["timer"] = {"type": "calendar", "onCalendar": args[2]}
        print(f"{name}: cron -> {args[2]}")
    elif kind == "interval" and len(args) >= 3:
        try:
            sec = int(args[2])
        except ValueError:
            print("ERR interval 需秒数", file=sys.stderr)
            sys.exit(2)
        app["timer"] = {"type": "interval", "onUnitActiveSec": sec}
        print(f"{name}: interval -> {sec}s")
    else:
        print(cmd_set_timer.__doc__, file=sys.stderr)
        sys.exit(2)
    write_config(cfg)
    print("下次 HAP tick（10 秒内）自动生效，无需 reload")


def cmd_set_autohide(args):
    """设置启动时是否自动隐藏到托盘（开机自启场景设 true）。"""
    if not args or args[0].lower() not in ("true", "false", "1", "0"):
        print("用法: harbor set-autohide <true|false>", file=sys.stderr)
        sys.exit(2)
    val = args[0].lower() in ("true", "1")
    cfg = read_config()
    cfg["autoHideOnLaunch"] = val
    write_config(cfg)
    print(f"autoHideOnLaunch = {val}")
    print("下次 HAP 启动时生效（开机自启场景建议设 true）")


def cmd_cleanup(args):
    """清理 brew 已卸载服务的失效条目（对齐 brew services cleanup）。

    默认：把失效的 brew 服务标记 enabled:false（可逆，重装 formula 后可再启用）。
    --prune：从 apps.json 彻底移除失效条目。
    判据统一为 brew unit 文件是否还在磁盘（仅 opt/ 路径，手工 unit 一律跳过）。
    """
    prune = "--prune" in args
    cfg = read_config()
    stale_before = find_stale_brew_apps(cfg)
    if not stale_before:
        print("所有 brew 服务状态正常，无需清理。")
        return

    if prune:
        kept = prune_stale_brew_apps(cfg)
        removed = [a["name"] for a in stale_before]
        cfg["apps"] = kept
        write_config(cfg)
        for name in removed:
            print(f"已移除失效服务: {name}")
        print(f"共移除 {len(removed)} 项；如需恢复，重装 formula 后 'harbor discover --add <formula>'。")
        _reload_after_cleanup()
    else:
        changed = disable_stale_brew_apps(cfg)
        if changed:
            write_config(cfg)
            for name in changed:
                print(f"已禁用失效服务: {name}（可逆）")
            print("清理完成。彻底移除请用: harbor cleanup --prune")
            _reload_after_cleanup()
        else:
            print("失效服务均已禁用，无新增变更。")
            print("彻底移除请用: harbor cleanup --prune")


def _reload_after_cleanup():
    """cleanup 写配置后通知 HAP 立即重读，消除‘清了但列表还在’的困惑。
    HAP 未启动或 IPC 失败时静默跳过（配置已落盘，下次启动自然生效）。"""
    try:
        parse_ok(ipc("RELOAD"))
    except SystemExit:
        pass


def parse_unit_brief(path: str) -> dict:
    """从 .service 提取 ExecStart/Environment/Log 用于 info 展示。"""
    out = {"exec": "", "env": [], "log": ""}
    try:
        with open(path, encoding="utf-8") as f:
            in_service = False
            for line in f:
                line = line.strip()
                if line.startswith("["):
                    in_service = line == "[Service]"
                    continue
                if not in_service or not line or line.startswith(("#", ";")):
                    continue
                if "=" not in line:
                    continue
                k, v = line.split("=", 1)
                k, v = k.strip(), v.strip()
                if k == "ExecStart":
                    out["exec"] = v
                elif k == "Environment":
                    out["env"].append(v)
                elif k in ("StandardOutput", "StandardError") and v.startswith("append:"):
                    out["log"] = v[len("append:"):]
    except OSError:
        pass
    return out


def cmd_info(args):
    if not args:
        print("ERR info 需要服务名", file=sys.stderr)
        sys.exit(2)
    name = args[0]
    cfg = read_config()
    app = next((a for a in cfg["apps"] if a["name"] == name), None)
    if not app:
        print(f"ERR 无此服务: {name}", file=sys.stderr)
        sys.exit(1)
    print(f"Name:    {app['name']}")
    print(f"Type:    {app.get('type', 'exec')}")
    print(f"Enabled: {app.get('enabled', True)}")
    print(f"Pidfile: {app['pidfile']}")
    timer = app.get("timer")
    if timer:
        if timer.get("type") == "calendar":
            print(f"Timer:   OnCalendar {timer.get('onCalendar')}")
        else:
            print(f"Timer:   OnUnitActiveSec {timer.get('onUnitActiveSec')}s")
    if app.get("type") == "unit" and app.get("unit"):
        u = parse_unit_brief(app["unit"])
        print(f"Unit:    {app['unit']}")
        print(f"Command: {u['exec']}")
        if u["log"]:
            print(f"Log:     {u['log']}")
        for e in u["env"]:
            print(f"Env:     {e}")
    else:
        print(f"Command: {app.get('bin', '')} {' '.join(app.get('args', []))}")
        if app.get("log"):
            print(f"Log:     {app['log']}")
        for k, v in (app.get("env") or {}).items():
            print(f"Env:     {k}={v}")


def opt_unit(name: str) -> str:
    """brew formula 的稳定 unit 路径（opt/ 是 symlink，brew upgrade 后自动指向新版）。"""
    return os.path.expanduser(f"~/.harmonybrew/opt/{name}/sh.brew.{name}.service")


def discover_units() -> list:
    """扫描已装 brew formula 的 .service（用 opt/ 稳定路径）。"""
    units = []
    for path in sorted(glob.glob(os.path.join(CELLAR, "*", "*", "sh.brew.*.service"))):
        name = os.path.basename(path).replace("sh.brew.", "").replace(".service", "")
        units.append((name, opt_unit(name)))
    # 去重（同名多版本只留一个）
    seen, out = set(), []
    for name, u in units:
        if name not in seen and os.path.exists(u):
            seen.add(name)
            out.append((name, u))
    return out


def write_config(cfg: dict):
    os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
    with open(CONFIG, "w", encoding="utf-8") as f:
        json.dump(cfg, f, indent=2, ensure_ascii=False)
        f.write("\n")


def cmd_discover(args):
    """扫描已装 brew formula 的 .service，对比 apps.json。

    discover --add <formula> [name]  把某个 unit 加入 apps.json（用 opt/ 稳定路径）
    """
    cfg = read_config()
    configured_names = {a["name"] for a in cfg["apps"]}

    if args and args[0] == "--add":
        if len(args) < 2:
            print("ERR --add 需要 formula 名（如 zellij）", file=sys.stderr)
            sys.exit(2)
        formula = args[1]
        svc_name = args[2] if len(args) >= 3 else formula
        unit = opt_unit(formula)
        if not os.path.exists(unit):
            print(f"ERR 无此 brew service: {unit}", file=sys.stderr)
            sys.exit(1)
        if svc_name in configured_names:
            print(f"ERR 服务名已存在: {svc_name}", file=sys.stderr)
            sys.exit(1)
        pidfile = f"/data/storage/el2/base/cache/harbor/{svc_name}.pid"
        cfg["apps"].append({
            "name": svc_name,
            "type": "unit",
            "unit": unit,
            "pidfile": pidfile,
        })
        write_config(cfg)
        print(f"已加入 {svc_name} -> {unit}")
        print("运行 'harbor reload' 让 HAP 重读配置后即可 start")
        return

    units = discover_units()
    print(f"发现 {len(units)} 个 brew service（稳定 opt/ 路径）：")
    for name, u in units:
        mark = "*" if name in configured_names else " "
        print(f" [{mark}] {name:<16} {u}")
    print("\n[*] 已在 apps.json。加入新服务：harbor discover --add <formula>")
    print("pidfile 自动设为 /data/storage/el2/base/cache/harbor/<name>.pid")


def main():
    if len(sys.argv) < 2:
        cmd_list([])
        return
    sub = sys.argv[1]
    rest = sys.argv[2:]
    handlers = {
        "list": cmd_list,
        "start": lambda a: cmd_simple(a[0] if a else "", "START"),
        "stop": lambda a: cmd_simple(a[0] if a else "", "STOP"),
        "restart": lambda a: cmd_simple(a[0] if a else "", "RESTART"),
        "status": cmd_status,
        "info": cmd_info,
        "discover": cmd_discover,
        "cleanup": cmd_cleanup,
        "set-autohide": cmd_set_autohide,
        "set-timer": cmd_set_timer,
        "reload": lambda a: print(parse_ok(ipc("RELOAD"))),
        "ping": lambda a: print(parse_ok(ipc("PING"))),
        "-h": lambda a: print(__doc__),
        "--help": lambda a: print(__doc__),
    }
    if sub not in handlers:
        print(f"ERR 未知子命令: {sub}", file=sys.stderr)
        print(__doc__, file=sys.stderr)
        sys.exit(2)
    # 每次 CLI 运行自动检测失效的 brew 服务（只提示、不改配置）。
    # 提示走 stderr，不污染 pong/list 等 stdout 输出；排除 cleanup（它自己处理）与 help（纯帮助）。
    if sub not in ("cleanup", "-h", "--help"):
        try:
            report_stale_brew_apps(read_config())
        except SystemExit:
            pass
        except (OSError, ValueError, KeyError):
            pass  # 检测失败不阻断主命令
    handlers[sub](rest)


if __name__ == "__main__":
    main()
